{
  "scopeName": "markdown.reflect.codeblock",
  "injectionSelector": "L:text.html.markdown -markup.fenced_code.block.markdown -markup.inline.raw",
  "patterns": [
    {
      "name": "markup.fenced_code.block.markdown",
      "begin": "(^|\\G)([ \\t]*)((`|~)\\4{2,})[ \\t]*((?i:reflect|rfl))(?=[ \\t]|$)([^`]*$)",
      "end": "(^|\\G)[ \\t]*(\\3\\4*)[ \\t]*$",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "5": { "name": "fenced_code.block.language.markdown" },
        "6": { "name": "fenced_code.block.language.attributes.markdown" }
      },
      "endCaptures": {
        "2": { "name": "punctuation.definition.markdown" }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(?=.)",
          "while": "(^|\\G)(?![ \\t]*[`~]{3,}[ \\t]*$)",
          "contentName": "meta.embedded.block.reflect",
          "patterns": [
            { "include": "source.reflect" }
          ]
        }
      ]
    }
  ]
}
