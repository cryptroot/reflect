// expect-output: fib(0) = 0
// expect-output: fib(1) = 1
// expect-output: fib(2) = 1
// expect-output: fib(3) = 2
// expect-output: fib(4) = 3
// expect-output: fib(5) = 5
// expect-output: fib(6) = 8
// expect-output: fib(7) = 13
// expect-output: fib(8) = 21
// expect-output: fib(9) = 34
// expect-output: fib(10) = 55
// expect-output: fib(50) = 12586269025
// expect-output: fib(90) = 2880067194370816120
.module fibonacci 0.0.0
.main fibonacci.App
.requires reflect.core
.requires reflect.io

.class public final fibonacci.App {
    .method public static void main(reflect.core.String[] args) {
        .locals (int n)
    LOOP:
        ldloc    n
        ldc.i4   10
        bgt.i32  LARGE
        ldloc    n
        call     static void fibonacci.App::show(int)
        ldloc    n
        ldc.i4   1
        add.i32
        stloc    n
        br       LOOP
    LARGE:
        ldc.i4   50
        call     static void fibonacci.App::show(int)
        ldc.i4   90
        call     static void fibonacci.App::show(int)
        ret
    }
    .method static void show(int n) {
        ldstr    "fib("
        ldarg    n
        call     static reflect.core.String reflect.core.String::valueOf(int)
        call     static reflect.core.String reflect.core.String::concat(reflect.core.String, reflect.core.String)
        ldstr    ") = "
        call     static reflect.core.String reflect.core.String::concat(reflect.core.String, reflect.core.String)
        ldarg    n
        call     static long fibonacci.App::of(int)
        call     static reflect.core.String reflect.core.String::valueOf(long)
        call     static reflect.core.String reflect.core.String::concat(reflect.core.String, reflect.core.String)
        call     static void reflect.io.Console::println(reflect.core.Object?)
        ret
    }
    // The nth Fibonacci number by a loop, from fib(0) = 0 and fib(1) = 1.
    .method static long of(int n) {
        .locals (long previous, long current, long next)
        ldc.i8   1
        stloc    current
    LOOP:
        ldarg    n
        brfalse  DONE
        ldloc    previous
        ldloc    current
        add.i64
        stloc    next
        ldloc    current
        stloc    previous
        ldloc    next
        stloc    current
        ldarg    n
        ldc.i4   1
        sub.i32
        starg    n
        br       LOOP
    DONE:
        ldloc    previous
        ret
    }
}
