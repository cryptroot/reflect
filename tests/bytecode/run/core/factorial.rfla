// expect-output: 0! = 1
// expect-output: 1! = 1
// expect-output: 2! = 2
// expect-output: 3! = 6
// expect-output: 4! = 24
// expect-output: 5! = 120
// expect-output: 6! = 720
// expect-output: 7! = 5040
// expect-output: 8! = 40320
// expect-output: 9! = 362880
// expect-output: 10! = 3628800
// expect-output: 11! = 39916800
// expect-output: 12! = 479001600
// expect-output: 13! = 6227020800
// expect-output: 14! = 87178291200
// expect-output: 15! = 1307674368000
// expect-output: 16! = 20922789888000
// expect-output: 17! = 355687428096000
// expect-output: 18! = 6402373705728000
// expect-output: 19! = 121645100408832000
// expect-output: 20! = 2432902008176640000
.module factorial 0.0.0
.main factorial.App
.requires reflect.core
.requires reflect.io

.class public final factorial.App {
    .method public static void main(reflect.core.String[] args) {
        .locals (int n)
    LOOP:
        ldloc    n
        ldc.i4   20
        bgt.i32  DONE
        ldloc    n
        call     static reflect.core.String reflect.core.String::valueOf(int)
        ldstr    "! = "
        call     static reflect.core.String reflect.core.String::concat(reflect.core.String, reflect.core.String)
        ldloc    n
        call     static long factorial.App::of(int)
        call     static reflect.core.String reflect.core.String::valueOf(long)
        call     static reflect.core.String reflect.core.String::concat(reflect.core.String, reflect.core.String)
        call     static void reflect.io.Console::println(reflect.core.Object?)
        ldloc    n
        ldc.i4   1
        add.i32
        stloc    n
        br       LOOP
    DONE:
        ret
    }
    // n! by a loop; 20! is the largest that a long holds.
    .method static long of(int n) {
        .locals (long result)
        ldc.i8   1
        stloc    result
    LOOP:
        ldarg    n
        ldc.i4   1
        ble.i32  DONE
        ldloc    result
        ldarg    n
        conv.i32.i64
        mul.i64
        stloc    result
        ldarg    n
        ldc.i4   1
        sub.i32
        starg    n
        br       LOOP
    DONE:
        ldloc    result
        ret
    }
}
