    .method public static void println(reflect.core.Object? value) {
        ldc.i4   1
        ldarg    value
        call     static reflect.core.String reflect.core.String::valueOf(reflect.core.Object?)
        ldstr    "\n"
        call     static reflect.core.String reflect.core.String::concat(reflect.core.String, reflect.core.String)
        call     reflect.io.Console::write(int, reflect.core.String)
