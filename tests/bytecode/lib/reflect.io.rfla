// The stub of reflect.io (Q49), with the Console of ex §2.11.
.module reflect.io 0.0.0
.requires reflect.core
.exports reflect.io

.class public final reflect.io.Console extends reflect.core.Object {
    .method private static native void write(int fd, reflect.core.String text) {
    }
    .method public static void print(reflect.core.Object? value) {
        ldc.i4   1
        ldarg    value
        call     static reflect.core.String reflect.core.String::valueOf(reflect.core.Object?)
        call     reflect.io.Console::write(int, reflect.core.String)
        ret
